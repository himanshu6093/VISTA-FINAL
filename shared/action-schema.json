{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VISTA Action (server -> extension actuator)",
  "type": "object",
  "required": ["action"],
  "properties": {
    "thought": { "type": "string" },
    "action": { "enum": ["click", "type", "select", "scroll", "press", "navigate", "copy", "paste", "done"] },
    "targetId": { "type": "string", "pattern": "^e[0-9]+$" },
    "fallback_xy": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
    "value": { "type": "string", "maxLength": 2000, "description": "type: text to enter; navigate: http(s) URL" },
    "direction": { "enum": ["up", "down"] },
    "pixels": { "type": "integer", "minimum": 50, "maximum": 5000 },
    "key": { "enum": ["Enter", "Escape", "Tab"] },
    "done": { "type": "boolean" },
    "need_vision": { "type": "boolean" },
    "planner": { "type": "string" },
    "fallback_reason": { "type": ["string", "null"] }
  }
}

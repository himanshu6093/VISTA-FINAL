# VISTA server config — copy to .env (NEVER commit .env; keys stay local).
# Local open-weights path:
#   VLM_ENABLED=1
#   VLM_PROVIDER=ollama
#   VLM_MODEL=qwen2.5vl:3b
# Cloud path (recommended for smooth multi-step demos, ~2-4s/step):
VLM_ENABLED=1
VLM_PROVIDER=gemini
VLM_MODEL=gemini-flash-lite-latest
GOOGLE_API_KEY=paste-your-key-here
# (GEMINI_API_KEY is accepted as an alias)
# Alternative cloud path (OpenAI or any OpenAI-compatible gateway):
#   VLM_PROVIDER=openai
#   VLM_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=paste-your-key-here
#   OPENAI_BASE_URL=https://api.openai.com
VLM_TIMEOUT_S=60
